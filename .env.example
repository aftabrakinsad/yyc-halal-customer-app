# ── Database (shared with the Store Management app) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres?sslmode=disable"

# ── App ──
APP_URL="http://localhost:3000"

# ── Auth.js / Google Sign-In ──
# Generate with: npx auth secret
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Development only: shows a "Dev sign-in" form so the app can be tried without Google credentials.
AUTH_DEV_LOGIN="true"

# ── Payments ──
# "stripe" in production. "mock" is a development-only simulated processor.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Email (receipts & notifications) ── leave empty to log emails to the console
SMTP_URL=""
EMAIL_FROM="YYC Halal <orders@yychalal.ca>"

# ── Web push (optional) ── generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:orders@yychalal.ca"

# ── Store POS print agent ── shared secret the in-store printer agent uses
PRINT_AGENT_TOKEN=""
